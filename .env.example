# Copy to .env. These match docker-compose.yml, so they work as-is locally.
DATABASE_URL="postgresql://travellab:travellab@localhost:5432/travellab"

# Used by `npm test`. The tests wipe this database, so keep it separate.
TEST_DATABASE_URL="postgresql://travellab:travellab@localhost:5432/travellab_test"

# Production only (set these in Render, not here):
# DATABASE_URL         Neon *pooled* connection string, used by the app
# DIRECT_DATABASE_URL  Neon *direct* connection string, used by migrations
# FRONTEND_ORIGIN      the deployed site, e.g. https://travel-lab.vercel.app
#                      (comma-separate several; default http://localhost:3000)
# PORT                 set by Render automatically; default 3001
